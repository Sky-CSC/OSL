@using OSL_CDragon
@using OSL_Overlay.GameFlow.Patch
@inject PatchState PatchState
@inject CDragon Cdragon
@implements IDisposable

@* ---------------- Patch managament ---------------- *@
<SectionCard Title="Patch" Caption="Changes are shown on the overlays immediately.">
    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
        <MudTextField T="string" Label="Patch text" Placeholder="Patch" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                      Value="@PatchState.Info.Text" ValueChanged="v => PatchState.UpdateText(v)" />
        <MudTextField T="string" Label="Patch version" Placeholder="15.20" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                      Value="@PatchState.Info.Version" ValueChanged="v => PatchState.UpdatePatch(v)" />
        @if (!string.IsNullOrEmpty(Cdragon.ServedPatch) && PatchState.Info.Version != Cdragon.ServedPatch)
        {
            <MudTooltip Text="Version of the assets in use">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => PatchState.UpdatePatch(Cdragon.ServedPatch)">
                    Use @Cdragon.ServedPatch
                </MudButton>
            </MudTooltip>
        }
    </MudStack>
</SectionCard>

@code {
    protected override void OnInitialized()
    {
        PatchState.OnChange += RefreshUI;
    }

    private void RefreshUI()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        PatchState.OnChange -= RefreshUI;
    }
}
