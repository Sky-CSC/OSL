@page "/champselect"
@using OSL_Overlay.GameFlow.ChampSelect
@inject ChampSelectView1State ChampState
@implements IDisposable

<link rel="stylesheet" href="@Assets["css/champSelect/display.css"]" />

<PageTitle>OSL-Overlay - ChampSelect</PageTitle>

<PageHeader Title="Champ Select" Subtitle="Current bans and picks." />

@* ---------------- View1 link ---------------- *@
<SectionCard Title="Overlay links" Caption="Add these addresses in your cast software.">
    <OverlayLink Title="Champ Select view 1" Path="champselect/view1" />
    <MudButton Href="champselect/view1/custom" Size="Size.Small" Variant="Variant.Outlined" Class="mt-1">Customize the view</MudButton>
</SectionCard>

@* ---------------- Preview ---------------- *@
<SectionCard Title="Preview" Caption="Current state of the champion select.">
    <div class="champ-select">
        <b style="@($"color:{TeamColors.Blue};")">Blue Team Bans</b>
        <BanSlot Class="@Info.BlueTeam.Side" Team="@Info.BlueTeam" />
        <b style="@($"color:{TeamColors.Red};")">Red Team Bans</b>
        <BanSlot Class="@Info.RedTeam.Side" Team="@Info.RedTeam" />

        <br />
        <b style="@($"color:{TeamColors.Blue};")">Blue Team Picks</b>
        <div class="picks">
            <PlayersSlot Team="@Info.BlueTeam" />
            <b style="@($"color:{TeamColors.Red};")">Red Team Picks</b>
            <PlayersSlot Team="@Info.RedTeam" />
        </div>
    </div>
</SectionCard>

@code {
    private ChampSelectInfo Info => ChampState.LocalInfo;

    protected override void OnInitialized()
    {
        ChampState.OnChange += OnServiceChanged;
    }

    private void OnServiceChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ChampState.OnChange -= OnServiceChanged;
    }
}
