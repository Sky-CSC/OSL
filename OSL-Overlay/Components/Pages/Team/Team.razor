@page "/team/"
@using OSL_Overlay.GameFlow.Team
@inject TeamState TeamState
@implements IDisposable

@* ---------------- Team managament ---------------- *@
<PageTitle>OSL-Overlay - Team</PageTitle>

<style>
    .section {
        scroll-margin-top: 10vh;
    }
</style>

<PageHeader Title="Teams" Subtitle="Teams shown in the overlays. Edit them here, then save them in a file." />

<UnsavedChangesGuard Active="@(TeamState.IsBlueModified || TeamState.IsRedModified)" />

@* ---------------- Team swap ---------------- *@
<div class="mb-4">
    <SwitchButton Text="Swap Teams"
                  Icon="@Icons.Material.Filled.SwapHoriz"
                  BackgroundColor="@Colors.BlueGray.Darken4"
                  HoverBackgroundColor="@Colors.Red.Darken2"
                  TextColor="#ffffff"
                  OnClick="@TeamState.SwapTeams" />
</div>

<MudGrid Spacing="4">
    @* ---------------- Blue team ---------------- *@
    <MudItem xs="12" xl="6" id="blue-side" Class="section">
        <TeamEditor Title="Blue Team"
                    Accent="@TeamColors.Blue"
                    Info="@TeamState.BlueInfo"
                    Modified="@TeamState.IsBlueModified"
                    CanRevert="@(TeamState.BlueFile is not null)"
                    OnRevert="() => TeamState.FileSelectedBlue(TeamState.BlueFile!)"
                    AllCustomNames="@TeamState.DisplayBlueCustomName"
                    AllCustomNamesChanged="TeamState.DisplayCustomBlueName"
                    OnEdited="RefreshUI"
                    OnApply="TeamState.ApplyBlue">
            <Header>
                <StyleManager Label="Blue team file"
                              Modified="@TeamState.IsBlueModified"
                              RelativePath="data/teams"
                              CurrentFile="@TeamState.BlueFile"
                              OnSave="TeamState.SaveBlue"
                              OnFileSelected="TeamState.FileSelectedBlue"
                              HideDuplicate=true
                              FilePrefix="team" />
            </Header>
        </TeamEditor>
    </MudItem>

    @* ---------------- Red team ---------------- *@
    <MudItem xs="12" xl="6" id="red-side" Class="section">
        <TeamEditor Title="Red Team"
                    Accent="@TeamColors.Red"
                    Info="@TeamState.RedInfo"
                    Modified="@TeamState.IsRedModified"
                    CanRevert="@(TeamState.RedFile is not null)"
                    OnRevert="() => TeamState.FileSelectedRed(TeamState.RedFile!)"
                    AllCustomNames="@TeamState.DisplayRedCustomName"
                    AllCustomNamesChanged="TeamState.DisplayCustomRedName"
                    OnEdited="RefreshUI"
                    OnApply="TeamState.ApplyRed">
            <Header>
                <StyleManager Label="Red team file"
                              Modified="@TeamState.IsRedModified"
                              RelativePath="data/teams"
                              CurrentFile="@TeamState.RedFile"
                              OnSave="TeamState.SaveRed"
                              OnFileSelected="TeamState.FileSelectedRed"
                              HideDuplicate=true
                              FilePrefix="team" />
            </Header>
        </TeamEditor>
    </MudItem>
</MudGrid>

@code {
    protected override void OnInitialized()
    {
        TeamState.OnChange += RefreshUI;
    }

    private void RefreshUI()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        TeamState.OnChange -= RefreshUI;
    }
}
