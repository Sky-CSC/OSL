@page "/endgame"
@using OSL_Overlay.GameFlow.EndGame
@inject EndGameState EndGameState
@inject ISnackbar Snackbar
@implements IDisposable

@* ---------------- End game management ---------------- *@
<PageTitle>OSL-Overlay - EndGame</PageTitle>

<style>
    .section {
        scroll-margin-top: 10vh;
    }
</style>

<PageHeader Title="End Game" Subtitle="Statistics of a finished game: enter the match id, then choose the statistic to show." />

@* ---------------- Overlay links ---------------- *@
<SectionCard Title="Overlay links" Caption="Add these addresses in your cast software.">
    <OverlayLink Title="End Game view 1" Path="endgame/view1" />
    <MudButton Href="endgame/view1/custom" Size="Size.Small" Variant="Variant.Outlined" Class="mt-1">Customize the view</MudButton>
</SectionCard>

@* ---------------- Match ---------------- *@
<SectionCard Title="Match">
    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Start">
        <MudTextField T="string"
                      Label="Match id"
                      Placeholder="7550999924"
                      HelperText="Just the id, without the region prefix"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                      Style="max-width:260px;"
                      Error="@(_idMatch.Length > 0 && !long.TryParse(_idMatch, out _))"
                      ErrorText="The id is only digits"
                      @bind-Value="_idMatch" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddBox"
                   Disabled="@(_loading || !long.TryParse(_idMatch, out _))"
                   OnClick="SetIdMatch">
            Set match
        </MudButton>
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mt-2" />
        }
    </MudStack>
</SectionCard>

@* ---------------- Statistic ---------------- *@
<SectionCard Title="Statistic" Caption="Statistic shown on the overlay (damage dealt to champions by default).">
    <MudSelect T="string"
               Label="Statistic"
               Variant="Variant.Outlined" Margin="Margin.Dense"
               Style="max-width:420px;"
               Value="_statistic"
               ValueChanged="OnStatisticChanged">
        @foreach (string prop in EndGameState.ParticipantProperties)
        {
            <MudSelectItem T="string" Value="@prop">@prop</MudSelectItem>
        }
    </MudSelect>

    <MudText Typo="Typo.subtitle1" Class="mt-3 mb-2"><b>@EndGameState.Info.ChampionStats.Title.Txt</b></MudText>

    <MudGrid Spacing="2">
        <MudItem xs="12" md="6">
            <MudPaper Outlined="true" Class="pa-3" Style="@($"border-top:4px solid {TeamColors.Blue};")">
                <MudText Typo="Typo.subtitle1" Style="@($"color:{TeamColors.Blue};")"><b>Blue Team</b></MudText>
                <MudStack Spacing="1" Class="mt-1">
                    @foreach (var player in EndGameState.Info.ChampionStats.BlueTeam)
                    {
                        <MudPaper Class="pa-2" Elevation="0" Style="background:#0B849E1F; border-radius:8px;">
                            <MudText>@player.Stat.Txt</MudText>
                        </MudPaper>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Outlined="true" Class="pa-3" Style="@($"border-top:4px solid {TeamColors.Red};")">
                <MudText Typo="Typo.subtitle1" Style="@($"color:{TeamColors.Red};")"><b>Red Team</b></MudText>
                <MudStack Spacing="1" Class="mt-1">
                    @foreach (var player in EndGameState.Info.ChampionStats.RedTeam)
                    {
                        <MudPaper Class="pa-2" Elevation="0" Style="background:#BE1E371F; border-radius:8px;">
                            <MudText>@player.Stat.Txt</MudText>
                        </MudPaper>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
</SectionCard>

@code {
    private string _idMatch = string.Empty;
    private string? _statistic;
    private bool _loading;

    protected override void OnInitialized()
    {
        EndGameState.OnChange += OnServiceChanged;
    }

    private void OnServiceChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        EndGameState.OnChange -= OnServiceChanged;
    }

    private void OnStatisticChanged(string? selected)
    {
        _statistic = selected;
        if (!string.IsNullOrEmpty(selected))
            EndGameState.UpdateTotalInfo(selected);
    }

    public async Task SetIdMatch()
    {
        if (!long.TryParse(_idMatch, out long idMatch))
            return;

        _loading = true;
        try
        {
            await EndGameState.CustomSetMatch(idMatch);
            await EndGameState.CustomSetTimeline(idMatch);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"The match could not be loaded: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
