@page "/obs"
@using OSL_UI.Box

<PageTitle>OSL-Overlay - OBS</PageTitle>

<PageHeader Title="OBS" Subtitle="Add the overlays in your cast software (OBS or equivalent)." />

<SectionCard Title="Overlay size">
    <Info Title="Size of all the overlays"
          Text="3840 * 2160 (16:9). Enter this value as the width and the height of the browser source, then resize it to the size of the screen." />
    <MudExpansionPanels Elevation="0" Class="mt-2">
        <MudExpansionPanel Text="Show an OBS video example">
            <DisplayGif ImageSrc="doc/obs/obs-example.gif"
                        Href="doc/obs/obs-example.gif"
                        Alt="Exemple OBS"
                        Width="640"
                        Height="360" />
        </MudExpansionPanel>
    </MudExpansionPanels>
</SectionCard>

<MudGrid Spacing="3">
    <MudItem xs="12" xl="6">
        <SectionCard Title="Champ Select">
            <OverlayLink Title="Champ Select view 1" Path="champselect/view1" />
        </SectionCard>

        <SectionCard Title="End Game">
            <OverlayLink Title="End Game view 1" Path="endgame/view1" />
        </SectionCard>
    </MudItem>

    <MudItem xs="12" xl="6">
        <SectionCard Title="Fearless" Caption="One link per game and per side.">
            <OverlayLink Title="View 1 - Game 1 - Blue" Path="fearless/view1/0/0" Accent="@TeamColors.Blue" />
            <OverlayLink Title="View 1 - Game 1 - Red" Path="fearless/view1/0/1" Accent="@TeamColors.Red" />
            <OverlayLink Title="View 1 - Game 2 - Blue" Path="fearless/view1/1/0" Accent="@TeamColors.Blue" />
            <OverlayLink Title="View 1 - Game 2 - Red" Path="fearless/view1/1/1" Accent="@TeamColors.Red" />
            <OverlayLink Title="View 1 - Game X - Blue" Path="fearless/view1/X-1/0" Accent="@TeamColors.Blue" />
            <OverlayLink Title="View 1 - Game X - Red" Path="fearless/view1/X-1/1" Accent="@TeamColors.Red" />
            <OverlayLink Title="View 2" Path="fearless/view2" />
        </SectionCard>
    </MudItem>
</MudGrid>
