@page "/fearless"
@using OSL_CDragon
@using OSL_Overlay.GameFlow.Fearless
@using OSL_RGDP.Schema.Riot
@using OSL_RGDP.WebSocketResponse
@using OSL_UI.Box
@inject FearlessState FearlessState
@inject CDragon _cdragon
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>OSL-Overlay - Fearless</PageTitle>

<style>
    .section {
        scroll-margin-top: 10vh;
    }
</style>

<PageHeader Title="Fearless" Subtitle="Champions banned from the games already played. Set the games in order." >
    <Actions>
        <MudButton OnClick="ResetFearlessList" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.SettingsBackupRestore">
            Reset all games
        </MudButton>
    </Actions>
</PageHeader>

@* ---------------- Overlay links ---------------- *@
<SectionCard Title="Overlay links" Caption="Add these addresses in your cast software.">
    @if (FearlessState.FearlessList.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Set a game to get the links of the view 1.</MudText>
    }
    @for (int i = 0; i < FearlessState.FearlessList.Count; i++)
    {
        <OverlayLink Title="@($"View 1 - Game {i + 1} - Blue")" Path="@($"fearless/view1/{i}/0")" Accent="@TeamColors.Blue" />
        <OverlayLink Title="@($"View 1 - Game {i + 1} - Red")" Path="@($"fearless/view1/{i}/1")" Accent="@TeamColors.Red" />
    }
    <OverlayLink Title="View 2" Path="fearless/view2" />
    <MudStack Row="true" Spacing="2" Class="mt-1">
        <MudButton Href="fearless/view1/customize" Size="Size.Small" Variant="Variant.Outlined">Customize view 1</MudButton>
        <MudButton Href="fearless/view2/customize" Size="Size.Small" Variant="Variant.Outlined">Customize view 2</MudButton>
    </MudStack>
</SectionCard>

@* ---------------- Games ---------------- *@
<SectionCard Title="Games" Caption="For each game, enter a match id or choose the champions manually.">
    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Start" Class="mb-3">
        <MudNumericField T="int" Label="Number of games" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="7"
                         Style="width:170px;"
                         Value="@_nbFearlessMatch" ValueChanged="v => _nbFearlessMatch = v" />
        <MudTextField T="string" Label="Match id" Placeholder="7550999924" HelperText="Just the id, without the region prefix"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                      Style="max-width:260px;"
                      Error="@(_idMatch.Length > 0 && !long.TryParse(_idMatch, out _))"
                      ErrorText="The id is only digits"
                      @bind-Value="_idMatch" />
    </MudStack>

    @for (int i = 1; i <= _nbFearlessMatch; i++)
    {
        int index = i;
        // A game can only be set after the previous ones, and only the last one can be deleted
        bool disableAdd = index - 1 > FearlessState.FearlessList.Count;
        bool disableDelete = index != FearlessState.FearlessList.Count;
        var match = index <= FearlessState.FearlessList.Count ? FearlessState.FearlessList[index - 1] : null;

        <MudPaper Outlined="true" Class="pa-3 mb-2">
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.subtitle1" Style="min-width:70px;"><b>Game @index</b></MudText>

                <div style="flex:1 1 220px; min-width:200px;">
                    @if (match is null)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Not set</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption">@(match[0].IdMatch != "0" ? $"Match id {match[0].IdMatch}" : "Set manually")</MudText>
                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                            @foreach (var team in match)
                            {
                                @foreach (var champion in team.Champions)
                                {
                                    <img src="@champion.Image.Path" width="32" height="32" alt="champion" style="border-radius:4px;" />
                                }
                            }
                        </MudStack>
                    }
                </div>

                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddBox"
                           Disabled="@(disableAdd || !long.TryParse(_idMatch, out _))"
                           OnClick="() => AddIdMatch(index - 1)">
                    From match id
                </MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.TouchApp"
                           Disabled="@disableAdd"
                           OnClick="() => AddCustomMatch(index - 1)">
                    From the champions below
                </MudButton>
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                           Disabled="@disableDelete"
                           OnClick="() => DeleteFearlessIndex(index - 1)">
                    Delete
                </MudButton>
            </MudStack>
        </MudPaper>
    }
</SectionCard>

@* ---------------- Champions chosen manually ---------------- *@
<SectionCard Title="Champions set manually" Caption="Choose the champions, then click 'From the champions below' on the game.">
    <MudText Typo="Typo.subtitle2" Style="@($"color:{TeamColors.Blue};")"><b>Blue Team</b></MudText>
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-2">
        @for (int i = 0; i < _nbPlayer - 5; i++)
        {
            int index = i;
            <StyleFieldEditor Type="champion-square-portrait-image"
                              Champions="@_cdragon.GetAllChampions()"
                              OnChampionSelected="@(champ => GetChampionSquare(index, champ))"
                              DefaultImage="@_cdragon.GetDefaultImage()"
                              BorderColor="@TeamColors.Blue" />
        }
    </MudStack>
    <MudText Typo="Typo.subtitle2" Style="@($"color:{TeamColors.Red};")"><b>Red Team</b></MudText>
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
        @for (int i = 5; i < _nbPlayer; i++)
        {
            int index = i;
            <StyleFieldEditor Type="champion-square-portrait-image"
                              Champions="@_cdragon.GetAllChampions()"
                              OnChampionSelected="@(champ => GetChampionSquare(index, champ))"
                              DefaultImage="@_cdragon.GetDefaultImage()"
                              BorderColor="@TeamColors.Red" />
        }
    </MudStack>
</SectionCard>

@code {
    private string _idMatch = string.Empty;
    private int _index = 0;
    private int _nbFearlessMatch = 2;
    private int _nbPlayer = 10;

    private List<OSL_CDragon.Schema.Champion?> _selectedChampions = Enumerable.Repeat<OSL_CDragon.Schema.Champion?>(null, 10).ToList();

    private void GetChampionSquare(int index, OSL_CDragon.Schema.Champion champ)
    {
        _selectedChampions[index] = champ;
    }

    public async Task AddIdMatch(int index)
    {
        if (!long.TryParse(_idMatch, out long idMatch))
            return;

        try
        {
            await FearlessState.MatchIdModeAsync(idMatch, index);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"The match could not be loaded: {ex.Message}", Severity.Error);
        }
    }
    public async Task AddCustomMatch(int index)
    {
        MatchDto matchDto = new();
        InfoDto infoDto = new();
        List<ParticipantDto> participantDto = new();
        for (int i = 0; i < _selectedChampions.Count; i++)
        {
            ParticipantDto player = new();
            if (_selectedChampions[i] != null)
            {
                player.ChampionId = _selectedChampions[i].Id;
            }
            else
            {
                player.ChampionId = 0;
            }
            if (i < 5)
            {
                player.TeamId = 100;
            }
            else
            {
                player.TeamId = 200;
            }
            participantDto.Add(player);
        }

        infoDto.Participants = participantDto;
        infoDto.GameId = 0;
        matchDto.Info = infoDto;
        FearlessMatchDto fearlessMatchDto = new(index, matchDto);

        FearlessState.AddFearlessList(fearlessMatchDto);
    }

    public void DeleteFearlessIndex(int index)
    {
        FearlessState.DeleteFearlessIndex(index);
    }

    public void ResetFearlessList()
    {
        _index = 0;
        FearlessState.ResetFearlessList();
    }

    private void OnStyleChanged(Action<string> setter, string newValue)
    {
        setter(newValue);
        RefreshUI();
    }

    private void OnStyleChanged(Action<int> setter, string newValue)
    {
        setter(Convert.ToInt32(newValue));
        RefreshUI();
    }

    private void RefreshUI()
    {
        InvokeAsync(StateHasChanged);
        FearlessState.NotifyStateChanged();
    }

    protected override void OnInitialized()
    {
        FearlessState.OnChange += OnServiceChanged;
    }

    private void OnServiceChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        FearlessState.OnChange -= OnServiceChanged;
    }
}
