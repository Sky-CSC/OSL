@page "/"
@using OSL_CDragon
@using OSL_Overlay.GameFlow.Team
@using OSL_UI.Icons
@implements IDisposable
@inject CDragon Cdragon
@inject TeamState TeamState

<PageTitle>OSL-Overlay - Home</PageTitle>

<PageHeader Title="Welcome to OSL"
            Subtitle="Display more and more information for your League of Legends tournaments." />

@* ---------------- Status ---------------- *@
<MudGrid Spacing="3" Class="mb-2">
    <MudItem xs="12" md="4">
        <SectionCard Title="OSL-Server" Caption="Source of the game data">
            <MudStack Spacing="2" AlignItems="AlignItems.Start">
                <ServerStatusChip Size="Size.Medium" />
                <MudButton Href="config/websocket" Size="Size.Small" Variant="Variant.Outlined">Server settings</MudButton>
            </MudStack>
        </SectionCard>
    </MudItem>

    <MudItem xs="12" md="4">
        <SectionCard Title="Assets" Caption="Images and names used by the overlays">
            <MudStack Spacing="2" AlignItems="AlignItems.Start">
                <MudText>
                    @if (string.IsNullOrEmpty(Cdragon.ServedPatch))
                    {
                        <b>No assets yet</b>
                    }
                    else
                    {
                        <b>@Cdragon.ServedPatch · @CDragon.DisplayRegion(Cdragon.ServedRegion)</b>
                        <MudChip T="string" Size="Size.Small" Color="@(Cdragon.IsPinned ? Color.Warning : Color.Success)" Class="ml-2">
                            @(Cdragon.IsPinned ? "Chosen manually" : "Automatic")
                        </MudChip>
                    }
                </MudText>
                @if (Cdragon.Status.IsBusy)
                {
                    <MudText Typo="Typo.caption">@Cdragon.Status.Message</MudText>
                }
                <MudButton Href="config/assets" Size="Size.Small" Variant="Variant.Outlined">Manage assets</MudButton>
            </MudStack>
        </SectionCard>
    </MudItem>

    <MudItem xs="12" md="4">
        <SectionCard Title="Teams" Caption="Teams shown in the overlays">
            <MudStack Spacing="1" AlignItems="AlignItems.Start">
                <MudText Style="@($"color:{TeamColors.Blue};")"><b>@TeamLabel(TeamState.BlueInfo.Name, TeamState.BlueInfo.Tag, "Blue team")</b></MudText>
                <MudText Style="@($"color:{TeamColors.Red};")"><b>@TeamLabel(TeamState.RedInfo.Name, TeamState.RedInfo.Tag, "Red team")</b></MudText>
                <MudButton Href="team" Size="Size.Small" Variant="Variant.Outlined" Class="mt-1">Edit teams</MudButton>
            </MudStack>
        </SectionCard>
    </MudItem>
</MudGrid>

@* ---------------- Modules ---------------- *@
<MudText Typo="Typo.h5" Class="mb-2 mt-4"><b>Modules</b></MudText>
<MudGrid Spacing="3">
    @foreach (ModuleInfo module in Modules)
    {
        <MudItem xs="12" sm="6" lg="4">
            <MudPaper Elevation="2" Class="pa-3" Style="height:100%;">
                <MudStack Spacing="1" Style="height:100%;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@module.Icon" Color="@(module.InDevelopment ? Color.Default : Color.Primary)" />
                        <MudText Typo="Typo.subtitle1"><b>@module.Title</b></MudText>
                        @if (module.InDevelopment)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">In development</MudChip>
                        }
                    </MudStack>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="flex:1;">@module.Description</MudText>
                    @if (!module.InDevelopment)
                    {
                        <div><MudButton Href="@module.Href" Size="Size.Small" Variant="Variant.Outlined">Open</MudButton></div>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@* ---------------- Requirements and documentation ---------------- *@
<MudExpansionPanels Class="mt-6" Elevation="0">
    <MudExpansionPanel Text="Requirements and documentation">
        <MudStack Spacing="1">
            <MudText>To use this application you need :</MudText>
            <MudText>• <MudLink Href="https://github.com/Sky-CSC/OSL" Target="_blank">OSL-Server 2.1.3 or above</MudLink></MudText>
            <MudText>• <MudLink Href="https://obsproject.com/fr" Target="_blank">OBS or equivalent</MudLink> (to display the overlays)</MudText>
            <MudText>
                Full documentation :
                <MudLink Href="https://doc.osl.sky-csc.fr" Target="_blank"><b>OSL web site documentation</b></MudLink>
            </MudText>
        </MudStack>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    private sealed record ModuleInfo(string Title, string Description, string Icon, string Href, bool InDevelopment = false);

    private static readonly ModuleInfo[] Modules =
    [
        new("OBS", "List of all the overlay links to add to your cast software.", Icons.Material.Filled.Link, "obs"),
        new("Teams", "Choose the two teams: logo, name, tag, players and images shown on the overlays.", Icons.Material.Filled.Diversity3, "team"),
        new("Texts", "Best of, patch, phase and VS texts shown on the overlays.", Icons.Material.Filled.TextFields, "text"),
        new("Champ Select", "Current bans and picks.", Icons.Material.Filled.FactCheck, "champselect"),
        new("Fearless", "Champions banned from the games already played (fearless mode).", Icons.Material.Filled.ImageNotSupported, "fearless"),
        new("End Game", "Statistics of a finished game: enter the match id and choose a statistic.", Icons.Material.Filled.InsertChart, "endgame"),
        new("Runes", "Runes of the players.", CustomIcons.Custom.Rune, "rune", true),
        new("In Game", "Gold, towers, items, objectives...", Icons.Material.Filled.SportsEsports, "ingame", true),
    ];

    private static string TeamLabel(string? name, string? tag, string fallback)
    {
        if (string.IsNullOrWhiteSpace(name))
            return fallback;
        return string.IsNullOrWhiteSpace(tag) ? name : $"{name} [{tag}]";
    }

    protected override void OnInitialized()
    {
        Cdragon.Updated += Refresh;
        Cdragon.StatusChanged += OnStatusChanged;
        TeamState.OnChange += Refresh;
    }

    // Raised from background threads
    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    private void OnStatusChanged(AssetSyncStatus status) => Refresh();

    public void Dispose()
    {
        Cdragon.Updated -= Refresh;
        Cdragon.StatusChanged -= OnStatusChanged;
        TeamState.OnChange -= Refresh;
    }
}
