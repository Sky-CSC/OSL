@using OSL_Overlay.GameFlow.Bo
@inject BoState BoState
@implements IDisposable

@* ---------------- Best of managament ---------------- *@
<SectionCard Title="Best Of" Caption="Score of the series. The overlays are updated when you click Apply.">
    <Actions>
        <SwitchButton Text="Swap Bo"
                      Icon="@Icons.Material.Filled.SwapHoriz"
                      BackgroundColor="@Colors.BlueGray.Darken4"
                      HoverBackgroundColor="@Colors.Red.Darken2"
                      TextColor="#ffffff"
                      OnClick="@BoState.SwapBo" />
    </Actions>
    <ChildContent>
        <MudGrid Spacing="3">
            @* ---------------- Blue bo ---------------- *@
            <MudItem xs="12" lg="6" id="blue-side" Class="section">
                <MudPaper Outlined="true" Class="pa-3" Style="@($"border-left: 5px solid {TeamColors.Blue};")">
                    <MudText Typo="Typo.subtitle1" Style="@($"color:{TeamColors.Blue};")"><b>Blue Team</b></MudText>
                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mt-2">
                        <MudTextField T="string" Label="Text" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                      Value="@BoState.BlueInfo.Text" ValueChanged="v => BoState.BlueInfo.Text = v" />
                        <MudNumericField T="int" Label="Games" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="5"
                                         Style="width:100px;"
                                         Value="@BoState.BlueInfo.NbGames" ValueChanged="v => BoState.BlueInfo.NbGames = v" />
                        <MudNumericField T="int" Label="Won" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="5"
                                         Style="width:100px;"
                                         Error="@(BoState.BlueInfo.Win > BoState.BlueInfo.NbGames)"
                                         ErrorText="More than the games"
                                         Value="@BoState.BlueInfo.Win" ValueChanged="v => BoState.BlueInfo.Win = v" />
                        <MudButton OnClick="BoState.UpdateBlueBo" Variant="Variant.Filled" Color="Color.Success">Apply</MudButton>
                        <MudButton OnClick="BoState.ResetBlueBo" Variant="Variant.Outlined" Color="Color.Error">Reset</MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>

            @* ---------------- Red bo ---------------- *@
            <MudItem xs="12" lg="6" id="red-side" Class="section">
                <MudPaper Outlined="true" Class="pa-3" Style="@($"border-left: 5px solid {TeamColors.Red};")">
                    <MudText Typo="Typo.subtitle1" Style="@($"color:{TeamColors.Red};")"><b>Red Team</b></MudText>
                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mt-2">
                        <MudTextField T="string" Label="Text" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                      Value="@BoState.RedInfo.Text" ValueChanged="v => BoState.RedInfo.Text = v" />
                        <MudNumericField T="int" Label="Games" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="5"
                                         Style="width:100px;"
                                         Value="@BoState.RedInfo.NbGames" ValueChanged="v => BoState.RedInfo.NbGames = v" />
                        <MudNumericField T="int" Label="Won" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="5"
                                         Style="width:100px;"
                                         Error="@(BoState.RedInfo.Win > BoState.RedInfo.NbGames)"
                                         ErrorText="More than the games"
                                         Value="@BoState.RedInfo.Win" ValueChanged="v => BoState.RedInfo.Win = v" />
                        <MudButton OnClick="BoState.UpdateRedBo" Variant="Variant.Filled" Color="Color.Success">Apply</MudButton>
                        <MudButton OnClick="BoState.ResetRedBo" Variant="Variant.Outlined" Color="Color.Error">Reset</MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </ChildContent>
</SectionCard>

@code {
    protected override void OnInitialized()
    {
        BoState.OnChange += RefreshUI;
    }

    private void RefreshUI()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        BoState.OnChange -= RefreshUI;
    }
}
