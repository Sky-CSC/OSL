@using OSL_Overlay.GameFlow.Phase
@inject PhaseState PhaseState
@implements IDisposable

@* ---------------- Phase managament ---------------- *@
<SectionCard Title="Phase" Caption="Changes are shown on the overlays immediately.">
    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
        <MudTextField T="string" Label="Phase text" Placeholder="Swiss Group - Round 1" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                      Value="@PhaseState.Info.Phase.Txt" ValueChanged="v => PhaseState.UpdatePhaseText(v)" />
        <MudTextField T="string" Label="Event text" Placeholder="2025 OcciLan" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                      Value="@PhaseState.Info.Event.Txt" ValueChanged="v => PhaseState.UpdateEventText(v)" />
        <MudTextField T="string" Label="Date text" Placeholder="24 Oct" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                      Value="@PhaseState.Info.Date.Txt" ValueChanged="v => PhaseState.UpdateDateText(v)" />
    </MudStack>
</SectionCard>

@code {
    protected override void OnInitialized()
    {
        PhaseState.OnChange += RefreshUI;
    }

    private void RefreshUI()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        PhaseState.OnChange -= RefreshUI;
    }
}
