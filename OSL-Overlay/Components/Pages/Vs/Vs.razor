@using OSL_Overlay.GameFlow.Vs
@inject VsState VsState
@implements IDisposable

@* ---------------- VS managament ---------------- *@
<SectionCard Title="VS" Caption="Changes are shown on the overlays immediately.">
    <MudTextField T="string" Label="VS text" Placeholder="VS" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                  Style="max-width:200px;"
                  Value="@VsState.Info.Text" ValueChanged="v => VsState.UpdateText(v)" />
</SectionCard>

@code {
    protected override void OnInitialized()
    {
        VsState.OnChange += RefreshUI;
    }

    private void RefreshUI()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        VsState.OnChange -= RefreshUI;
    }
}
