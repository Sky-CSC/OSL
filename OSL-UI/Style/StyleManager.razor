@using MudBlazor
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@* ---------------- Style manager: choose a file, then act on the selected file ---------------- *@
<MudPaper Outlined="true" Class="pa-3">

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mb-2">
        <MudText Typo="Typo.subtitle1"><b>@Label</b></MudText>
        @if (Modified)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning">Unsaved changes</MudChip>
        }
    </MudStack>

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">

        @* ---------------- 1. Which file ---------------- *@
        <MudSelect @key="_selectKey"
                   T="string"
                   Label="File"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Style="min-width:200px; flex:1 1 200px;"
                   Value="@SelectedName"
                   ValueChanged="SelectFile"
                   ToStringFunc="Display"
                   Disabled="@(HideSelect || _mode != EditMode.None)">
            @foreach (string file in _files)
            {
                <MudSelectItem T="string" Value="@file">@Display(file)@(IsProtected(file) ? " (default)" : "")</MudSelectItem>
            }
        </MudSelect>

        @* ---------------- 2. Write the current settings ---------------- *@
        <MudTooltip Text="@SaveTooltip">
            <span>
                <MudButton Variant="@(Modified ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@CannotSave"
                           OnClick="SaveSelectedAsync">
                    Save
                </MudButton>
            </span>
        </MudTooltip>
        <MudTooltip Text="Write the current settings in a new file">
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(_mode != EditMode.None)"
                       OnClick="() => StartMode(EditMode.SaveAs)">
                Save as new
            </MudButton>
        </MudTooltip>

        @* ---------------- 3. Manage the selected file ---------------- *@
        <MudTooltip Text="@RenameTooltip">
            <span>
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Style="@($"color:{Colors.Orange.Default};")"
                               Disabled="@CannotRename"
                               OnClick="() => StartMode(EditMode.Rename)" />
            </span>
        </MudTooltip>
        <MudTooltip Text="Duplicate the selected file">
            <span>
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                               Style="@($"color:{Colors.Blue.Default};")"
                               Disabled="@CannotDuplicate"
                               OnClick="DuplicateAsync" />
            </span>
        </MudTooltip>
        <MudTooltip Text="@DeleteTooltip">
            <span>
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Style="@($"color:{Colors.Red.Darken4};")"
                               Disabled="@CannotDelete"
                               OnClick="DeleteAsync" />
            </span>
        </MudTooltip>
    </MudStack>

    @* ---------------- Name of the new file / new name ---------------- *@
    @if (_mode != EditMode.None)
    {
        <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2" Wrap="Wrap.Wrap" Class="mt-3">
            <MudTextField T="string"
                          Label="@(_mode == EditMode.SaveAs ? "Name of the new file" : "New name")"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          @bind-Value="_nameInput"
                          Error="@(_error is not null)"
                          ErrorText="@_error" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmModeAsync">
                @(_mode == EditMode.SaveAs ? "Save" : "Rename")
            </MudButton>
            <MudButton Variant="Variant.Text" OnClick="CancelMode">Cancel</MudButton>
        </MudStack>
    }
</MudPaper>
